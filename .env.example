# ------------------------------------------------------------------
# Plano — environment variables
# Copy this file to `.env` at the project root before running locally:
#
#   cp .env.example .env
#
# The API key NEVER ships to the browser. It is read server-side only
# (server/index.js + server/llm.js) and used for /api/ai/* requests.
# Leave both keys empty to run Plano with the built-in offline engine.
# ------------------------------------------------------------------

# Which provider to use: auto | anthropic | openai
# (auto prefers Anthropic when both keys are set)
LLM_PROVIDER=auto

# --- Anthropic (recommended) --------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OpenAI --------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Server --------------------------------------------------------
# Port the Express server listens on (Vite dev server runs on 5173 and
# proxies /api -> this port)
PORT=3001

# Where account data (users, sessions, per-account snapshots) is stored.
# Defaults to ./server/data — point this at a persistent volume in
# production. Files are JSON; password hashes are scrypt.
# PLANO_DATA_DIR=