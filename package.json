{
  "name": "plano",
  "version": "1.0.0",
  "private": true,
  "description": "Plano — a time-management and productivity web app with a built-in AI Planning Assistant.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist --port 8788",
    "cf:migrate": "wrangler d1 migrations apply plano-app",
    "cf:deploy": "wrangler deploy",
    "cf:setup": "node scripts/cf-setup.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2",
    "wrangler": "^4.139.0"
  }
}
